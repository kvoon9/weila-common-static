---
// 文档编辑器:独立路由,左侧文件树 / 中间源码编辑器 / 右侧预览,可切换 Diff。
// 数据在构建期读入(见 ~/shared/editor-files),没有服务端依赖。
import EditorApp from '~/components/editor/EditorApp.vue'
import { loadEditorFiles } from '~/shared/editor-files'
import 'github-markdown-css/github-markdown.css'

const files = loadEditorFiles()
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>文档编辑器</title>
  </head>
  <body>
    <EditorApp client:only="vue" files={files} />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    height: 100%;
  }
</style>
