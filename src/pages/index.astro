---
// 站点根页就是文档编辑器:左侧文件树、中间源码、右侧预览。
// 文档页右上角的「打开编辑器」通过 ?file= 深链定位到具体文件。
import EditorApp from '~/components/editor/EditorApp.vue'
import EditorLayout from '~/layouts/EditorLayout.astro'
import { loadEditorFiles } from '~/shared/editor-files'

const files = loadEditorFiles()
---

<EditorLayout>
  <EditorApp client:only="vue" files={files} />
</EditorLayout>
