---
import ApiDoc from '~/components/work-exported-docs/ApiDoc.astro'
import WorkExportedDocs from '~/layouts/WorkExportedDocs.astro'
import data from '~/shared/work-exported-docs.json'
import type { ApiPage, WorkExportedDocsData } from '~/shared/work-exported-docs-types'

export function getStaticPaths() {
  const manual = data as WorkExportedDocsData
  return manual.pages.map((page) => ({ params: { slug: page.slug }, props: { page } }))
}

interface Props {
  page: ApiPage
}

const { page } = Astro.props
---

<WorkExportedDocs title={page.title} currentSlug={page.slug} diffs>
  <ApiDoc page={page} />
</WorkExportedDocs>
