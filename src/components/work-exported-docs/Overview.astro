---
import { manual } from '~/shared/work-exported-docs-data'
import { methodClass, statusClass } from '~/shared/work-exported-docs-ui'

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---

<header>
  <p class="docs-eyebrow">Work exported docs</p>
  <h1>{manual.title}</h1>
  <p class="docs-meta">
    来源：
    <a href={manual.sourceUrl} target="_blank" rel="noreferrer">
      Apipost「{manual.pathNames.join(' / ')}」
    </a>{' '}
    · 上游更新于 {manual.updatedAt}
  </p>
</header>

{manual.pages.length === 0 ? (
  <p class="docs-meta">上游暂无接口。</p>
) : (
  <div class="docs-cards">
    {manual.pages.map((page) => (
      <a class="docs-card" href={`${base}work-exported-docs/${page.slug}/`}>
        <div class="docs-card-top">
          <span class:list={['docs-method', methodClass(page.method)]}>{page.method}</span>
          {page.markName && <span class:list={['docs-status', statusClass(page.markName)]}>{page.markName}</span>}
        </div>
        <h2>{page.title}</h2>
        <p class="docs-card-endpoint">{page.endpoint}</p>
        {page.description !== '' && <p class="docs-card-description">{page.description}</p>}
      </a>
    ))}
  </div>
)}
