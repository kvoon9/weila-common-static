---
import type { SidebarItem } from '~/shared/work-exported-docs-types'

interface Props {
  items: SidebarItem[]
  currentSlug: string | null
  depth?: number
}

const { items, currentSlug, depth = 0 } = Astro.props
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const href = (slug: string) => `${base}work-exported-docs/${slug}/`
---

<ul class:list={['docs-tree', depth > 0 && 'docs-tree-nested']}>
  {items.map((item) => (
    <li>
      {item.kind === 'api' && item.slug !== null ? (
        <a class="docs-tree-link" href={href(item.slug)} aria-current={item.slug === currentSlug ? 'page' : undefined}>
          {item.title}
        </a>
      ) : (
        <span class="docs-tree-group" title={item.description || undefined}>
          {item.title}
        </span>
      )}
      {item.children.length > 0 && <Astro.self items={item.children} currentSlug={currentSlug} depth={depth + 1} />}
    </li>
  ))}
</ul>
