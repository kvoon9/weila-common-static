---
export interface DocsTreeItem {
  title: string
  description: string
  url: string | null
  children: DocsTreeItem[]
}

interface Props {
  items: DocsTreeItem[]
  current: string
  depth?: number
}

const { items, current, depth = 0 } = Astro.props
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`

const href = (url: string) => `${base}${url}`
const isCurrent = (url: string | null) => url !== null && href(url) === current
---

<ul class:list={['docs-tree', depth > 0 && 'docs-tree-nested']}>
  {items.map((item) => (
    <li class="docs-tree-item">
      {item.url === null ? (
        <span class="docs-tree-group">{item.title}</span>
      ) : (
        <a
          class:list={['docs-tree-link', isCurrent(item.url) && 'is-current']}
          href={href(item.url)}
          aria-current={isCurrent(item.url) ? 'page' : undefined}
        >
          {item.title}
        </a>
      )}
      {item.children.length > 0 && <Astro.self items={item.children} current={current} depth={depth + 1} />}
    </li>
  ))}
</ul>

<style>
  .docs-tree {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-tree-nested {
    margin-left: 0.75rem;
    padding-left: 0.75rem;
    border-left: 1px solid #d8dee4;
  }

  .docs-tree-item {
    margin: 0;
  }

  .docs-tree-group {
    display: block;
    padding: 0.35rem 0.5rem;
    color: #57606a;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .docs-tree-link {
    display: block;
    padding: 0.35rem 0.5rem;
    border-radius: 0.375rem;
    color: #24292f;
    font-size: 0.875rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .docs-tree-link:hover,
  .docs-tree-link:focus-visible {
    background: #eaeef2;
    color: #0969da;
    outline: none;
  }

  .docs-tree-link.is-current {
    background: #ddf4ff;
    color: #0969da;
    font-weight: 600;
  }

  @media (prefers-color-scheme: dark) {
    .docs-tree-nested {
      border-left-color: #30363d;
    }

    .docs-tree-group {
      color: #8b949e;
    }

    .docs-tree-link {
      color: #c9d1d9;
    }

    .docs-tree-link:hover,
    .docs-tree-link:focus-visible {
      background: #21262d;
      color: #58a6ff;
    }

    .docs-tree-link.is-current {
      background: #0c2d4a;
      color: #58a6ff;
    }
  }
</style>
